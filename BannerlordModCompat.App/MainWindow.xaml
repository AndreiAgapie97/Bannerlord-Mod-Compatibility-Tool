    <Window x:Class="BannerlordModCompat.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Bannerlord Mod Compatibility Analyzer"
        Height="960"
        Width="1540"
        MinHeight="680"
        MinWidth="1024"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#09080A"
        Foreground="#F4E7D0"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="16,11" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#2A2E34" />
            <Setter Property="Foreground" Value="#F4E7D0" />
            <Setter Property="BorderBrush" Value="#8B6A38" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#5C211C" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#C49B55" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#3E1714" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#A57C43" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2B2622" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#5F4B2B" />
                                <Setter Property="Foreground" Value="#CDBA97" />
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="BorderBrush" Value="#6C5330" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Foreground" Value="#F1E2C6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="1"
                                    Margin="0,9,0,0"
                                    Background="#111317"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                            </Border>
                            <Border Grid.Row="0"
                                    Margin="12,0,0,0"
                                    Padding="14,5"
                                    Background="#5B211C"
                                    BorderBrush="#8F6B38"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    HorizontalAlignment="Left">
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="#F7EAD1"
                                                  TextElement.FontWeight="SemiBold"
                                                  TextElement.FontFamily="Georgia"
                                                  TextElement.FontSize="16" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#13161B" />
            <Setter Property="Foreground" Value="#F3E4CB" />
            <Setter Property="BorderBrush" Value="#6F5630" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#161A21" />
            <Setter Property="Foreground" Value="#F3E4CB" />
            <Setter Property="BorderBrush" Value="#7C6135" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextElement.Foreground" Value="#F3E4CB" />
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#161A21" />
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#161A21" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#5B231E" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#433227" />
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F3E4CB" />
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F3E4CB" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFF6E8" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#F3E4CB" />
                <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#CDBB9C" />
            </Style.Resources>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#D2C2A5" />
                    <Setter Property="Background" Value="#2A2521" />
                    <Setter Property="BorderBrush" Value="#64502F" />
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#161A21" />
            <Setter Property="Foreground" Value="#F3E4CB" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#4B251F" />
                    <Setter Property="Foreground" Value="#FFF4E2" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#6A3027" />
                    <Setter Property="Foreground" Value="#FFF7EA" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#B7A789" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E7D8BE" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="#E7D8BE" />
            <Setter Property="TextElement.Foreground" Value="#E7D8BE" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#281D15" />
            <Setter Property="Foreground" Value="#F3E5C8" />
            <Setter Property="BorderBrush" Value="#725731" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="BorderBrush" Value="#32261C" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
            <Setter Property="TextBlock.TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="ColumnHeaderHeight" Value="46" />
            <Setter Property="AlternationCount" Value="2" />
            <Setter Property="HorizontalGridLinesBrush" Value="#2B221A" />
            <Setter Property="VerticalGridLinesBrush" Value="#2B221A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="MinRowHeight" Value="48" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Foreground" Value="#F0E2C8" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#5B231E" />
                    <Setter Property="Foreground" Value="#FFF4DF" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#DBC9A9" />
            <Setter Property="Background" Value="#1A1C20" />
            <Setter Property="BorderBrush" Value="#5E4729" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="22,11" />
            <Setter Property="MinWidth" Value="138" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="FontSize" Value="16.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Margin="0,0,4,0"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6,6,0,0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0">
                            <ContentPresenter x:Name="HeaderContent"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#62241F" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#C29A54" />
                                <Setter Property="Foreground" Value="#FFF0D7" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#2C3138" />
                                <Setter Property="Foreground" Value="#FFF4E7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#9F8B69" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FindingRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="#111419" />
            <Setter Property="Foreground" Value="#F1E6D2" />
            <Setter Property="BorderBrush" Value="#31261E" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                    <Setter Property="Background" Value="#3F1C1F" />
                    <Setter Property="BorderBrush" Value="#8C4347" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="High">
                    <Setter Property="Background" Value="#3D2A16" />
                    <Setter Property="BorderBrush" Value="#8B6732" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Medium">
                    <Setter Property="Background" Value="#30261D" />
                    <Setter Property="BorderBrush" Value="#8A6735" />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#463529" />
                    <Setter Property="BorderBrush" Value="#C49A55" />
                    <Setter Property="Foreground" Value="#FFF6E7" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>
            <Style x:Key="LoadOrderRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="#111419" />
            <Setter Property="Foreground" Value="#F1E6D2" />
            <Setter Property="BorderBrush" Value="#31261E" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChanged}" Value="True">
                    <Setter Property="Background" Value="#2B241C" />
                    <Setter Property="BorderBrush" Value="#73603D" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TabSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#F3E4C8" />
            <Setter Property="FontFamily" Value="Georgia" />
        </Style>
        <Style x:Key="SectionBannerBorderStyle" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#5B211C" />
            <Setter Property="BorderBrush" Value="#8F6B38" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="SectionBannerTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="Foreground" Value="#F7EAD1" />
        </Style>
        <Style x:Key="HeroChipBorderStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#1F1D1B" />
            <Setter Property="BorderBrush" Value="#6F5530" />
        </Style>
        <Style x:Key="HeroChipLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#D3C1A2" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="HeroChipValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#F7EAD1" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontFamily" Value="Georgia" />
        </Style>
        <Style x:Key="TabSectionHintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D3C1A2" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ActionRowLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E7D7BD" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="TabActionBarStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1B1C20" Offset="0" />
                        <GradientStop Color="#16181C" Offset="0.58" />
                        <GradientStop Color="#131418" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#70552E" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="ActionRowHintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D5C2A0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ActionRowButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="PlayerRuntimeCardBorderStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="#14171C" />
            <Setter Property="BorderBrush" Value="#6F5530" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="PlayerSettingsContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="#161A21" />
            <Setter Property="Foreground" Value="#F3E4CB" />
            <Setter Property="BorderBrush" Value="#7C6135" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style x:Key="PlayerSettingsMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#F3E4CB" />
            <Setter Property="Background" Value="#161A21" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="14" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#5B231E" />
                    <Setter Property="Foreground" Value="#FFF4E2" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,8"
                Padding="10"
                CornerRadius="10"
                BorderBrush="#866639"
                BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#5A201B" Offset="0" />
                    <GradientStop Color="#131418" Offset="0.62" />
                    <GradientStop Color="#0B0C0F" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Canvas Grid.ColumnSpan="2"
                        Width="210"
                        Height="88"
                        Margin="0,0,36,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Opacity="0.06"
                        IsHitTestVisible="False">
                    <Path Fill="#8F6B38"
                          Data="M130,8 L212,42 L212,98 L130,132 L48,98 L48,42 Z" />
                    <Path Stroke="#C29A54"
                          StrokeThickness="3"
                          Data="M130,22 L188,46 L188,92 L130,116 L72,92 L72,46 Z" />
                    <Path Stroke="#C29A54"
                          StrokeThickness="3"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="M94,54 L130,86 L166,54" />
                    <Path Stroke="#C29A54"
                          StrokeThickness="3"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="M94,88 L130,56 L166,88" />
                </Canvas>
                <StackPanel>
                    <TextBlock FontSize="19"
                               FontFamily="Georgia"
                               FontWeight="Bold"
                               Foreground="#F8E7C8"
                               TextWrapping="Wrap"
                               Text="Bannerlord Mod Compatibility Analyzer" />
                    <TextBlock Margin="0,3,0,0"
                               MaxWidth="780"
                               Foreground="#D6C09E"
                               TextWrapping="Wrap"
                               Text="Readable compatibility guidance with conflict reasons, probable outcomes, and better load-order suggestions." />
                    <Grid Margin="0,8,0,0"
                          MaxWidth="240">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Height="1"
                                VerticalAlignment="Center"
                                Background="#8A6A3D" />
                        <Border Grid.Column="1"
                                Width="14"
                                Height="14"
                                Margin="10,0"
                                Background="#5A201B"
                                BorderBrush="#C29A54"
                                BorderThickness="1"
                                CornerRadius="2"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <RotateTransform Angle="45" />
                            </Border.RenderTransform>
                        </Border>
                        <Border Grid.Column="2"
                                Height="1"
                                VerticalAlignment="Center"
                                Background="#8A6A3D" />
                    </Grid>
                </StackPanel>
                <Grid Grid.Column="1"
                      Margin="14,0,0,0"
                      VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Padding="10,6"
                                CornerRadius="10"
                                BorderBrush="#866639"
                                BorderThickness="1"
                                Background="#181A1F">
                            <StackPanel>
                                <TextBlock Text="Current Status" FontWeight="SemiBold" Foreground="#E4D2B4" />
                                <TextBlock x:Name="TxtStatusHeader"
                                           Margin="0,3,0,0"
                                           FontSize="15"
                                           FontFamily="Georgia"
                                           Foreground="#F8E9CC"
                                           FontWeight="Bold"
                                           Text="Not Scanned" />
                            </StackPanel>
                        </Border>
                        <WrapPanel Grid.Column="1"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right">
                            <Border x:Name="BorderHeroCriticalChip"
                                    Style="{StaticResource HeroChipBorderStyle}"
                                    Background="#3C1B27"
                                    BorderBrush="#744357">
                                <StackPanel>
                                    <TextBlock Text="Critical" Style="{StaticResource HeroChipLabelStyle}" Foreground="#FFD6DF" />
                                    <TextBlock x:Name="TxtHeroCriticalChip"
                                               Text="0"
                                               Style="{StaticResource HeroChipValueStyle}" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="BorderHeroHighChip"
                                    Style="{StaticResource HeroChipBorderStyle}"
                                    Background="#3B291A"
                                    BorderBrush="#8C6540">
                                <StackPanel>
                                    <TextBlock Text="High" Style="{StaticResource HeroChipLabelStyle}" Foreground="#FFE6B7" />
                                    <TextBlock x:Name="TxtHeroHighChip"
                                               Text="0"
                                               Style="{StaticResource HeroChipValueStyle}" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="BorderHeroRuntimeChip"
                                    Style="{StaticResource HeroChipBorderStyle}"
                                    Margin="0,0,0,6"
                                    Background="#1F241D"
                                    BorderBrush="#5E7658">
                                <StackPanel>
                                    <TextBlock Text="Runtime" Style="{StaticResource HeroChipLabelStyle}" Foreground="#D9E4D0" />
                                    <TextBlock x:Name="TxtHeroRuntimeChip"
                                               Text="0"
                                               Style="{StaticResource HeroChipValueStyle}" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </Grid>
                    <Button x:Name="BtnPlayerSettingsMenu"
                             Grid.Row="1"
                             Margin="0,8,0,0"
                             MinWidth="118"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Content="Settings"
                             Click="BtnPlayerSettingsMenu_Click">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="CtxPlayerSettings"
                                         Style="{StaticResource PlayerSettingsContextMenuStyle}">
                                <MenuItem x:Name="MenuToggleControlsPanel"
                                          Header="Hide Controls Panel"
                                          Style="{StaticResource PlayerSettingsMenuItemStyle}"
                                          Click="MenuToggleControlsPanel_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColControlsPanel" Width="320" MinWidth="240" MaxWidth="460" />
                <ColumnDefinition x:Name="ColControlsSplitter" Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,8,0">
                <StackPanel>
                    <GroupBox x:Name="GroupOperationsCenter" Header="Operations Center">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button x:Name="BtnRunScan"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,8,8"
                                        Content="Run Scan"
                                        Click="BtnRunScan_Click" />
                                <Button x:Name="BtnCollectRuntimeEvidence"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="0,0,0,8"
                                        Content="Collect Runtime Evidence"
                                        Click="BtnCollectRuntimeEvidence_Click" />
                                <Button x:Name="BtnApplyLoadOrder"
                                        Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Content="Apply Suggested Order"
                                        Click="BtnApplyLoadOrder_Click" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnExportJson"
                                        Grid.Column="0"
                                        Margin="0,0,8,0"
                                        Content="Export JSON"
                                        Click="BtnExportJson_Click" />
                                <Button x:Name="BtnExportMd"
                                        Grid.Column="1"
                                        Content="Export Markdown"
                                        Click="BtnExportMd_Click" />
                            </Grid>

                            <Border Height="1" Background="#6D5330" Margin="0,0,0,8" />
                            <TextBlock Foreground="#E4D2B5" FontWeight="SemiBold" Text="Session Presets" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button x:Name="BtnPresetCrashTriage"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,8,8"
                                        Content="Crash Triage"
                                        Click="BtnPresetCrashTriage_Click" />
                                <Button x:Name="BtnPresetRuntimeValidation"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="0,0,0,8"
                                        Content="Runtime Validation"
                                        Click="BtnPresetRuntimeValidation_Click" />
                                <Button x:Name="BtnPresetLoadOrderAudit"
                                        Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Content="Load Order Audit"
                                        Click="BtnPresetLoadOrderAudit_Click" />
                            </Grid>
                            <TextBlock x:Name="TxtPresetSummary"
                                       Margin="0,8,0,0"
                                       Foreground="#D8C7AA"
                                       TextWrapping="Wrap"
                                       Text="Select a preset to auto-focus tabs and filters." />

                            <Border Height="1" Background="#6D5330" Margin="0,8,0,8" />
                            <Expander x:Name="ExpAdvancedScanOptions"
                                      Header="Advanced Scan Options"
                                      IsExpanded="False"
                                      Foreground="#E7D8BE">
                                <StackPanel Margin="0,8,0,0">
                                    <CheckBox x:Name="ChkCustomOnlyFocus" IsChecked="False" Content="Show custom mods only (hide Native/framework modules)" />
                                    <CheckBox x:Name="ChkIncludeSave" IsChecked="True" Content="Include Save File Analysis" />
                                    <CheckBox x:Name="ChkIncludeLikelyIssues" IsChecked="True" Content="Include likely (probabilistic) issues" />
                                    <CheckBox x:Name="ChkIncludeDataNoise"
                                              IsChecked="False"
                                              Content="Include dependency/XML/DLL data-noise findings" />
                                    <CheckBox x:Name="ChkAllowCloud" IsChecked="False" Content="Allow Cloud Metadata (future mode)" />
                                    <TextBlock Margin="0,8,0,4" Foreground="#D8C7AA" Text="Target Game Version" />
                                    <TextBox x:Name="TxtGameVersion" Text="1.3.15" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="GroupGuidedWorkflow" Header="Guided Workflow">
                        <StackPanel>
                            <TextBlock Foreground="#D8C7AA"
                                       TextWrapping="Wrap"
                                       Text="Recommended path: Scan -> Triage -> Fix -> Validate."
                                       Margin="0,0,0,8" />

                            <Border x:Name="BorderWorkflowScan"
                                    Margin="0,0,0,6"
                                    Padding="8,6"
                                    CornerRadius="6"
                                    Background="#1D1E22"
                                    BorderBrush="#6D5330"
                                    BorderThickness="1">
                                <TextBlock x:Name="TxtWorkflowScanState"
                                           Foreground="#F1E2C6"
                                           Text="1) Scan: waiting for first scan." />
                            </Border>

                            <Border x:Name="BorderWorkflowTriage"
                                    Margin="0,0,0,6"
                                    Padding="8,6"
                                    CornerRadius="6"
                                    Background="#1D1E22"
                                    BorderBrush="#6D5330"
                                    BorderThickness="1">
                                <TextBlock x:Name="TxtWorkflowTriageState"
                                           Foreground="#F1E2C6"
                                           Text="2) Triage: review findings and focus critical/high items." />
                            </Border>

                            <Border x:Name="BorderWorkflowFix"
                                    Margin="0,0,0,6"
                                    Padding="8,6"
                                    CornerRadius="6"
                                    Background="#1D1E22"
                                    BorderBrush="#6D5330"
                                    BorderThickness="1">
                                <TextBlock x:Name="TxtWorkflowFixState"
                                           Foreground="#F1E2C6"
                                           Text="3) Fix: apply load-order moves or isolate candidate modules." />
                            </Border>

                            <Border x:Name="BorderWorkflowValidate"
                                    Margin="0,0,0,8"
                                    Padding="8,6"
                                    CornerRadius="6"
                                    Background="#1D1E22"
                                    BorderBrush="#6D5330"
                                    BorderThickness="1">
                                <TextBlock x:Name="TxtWorkflowValidateState"
                                           Foreground="#F1E2C6"
                                           Text="4) Validate: collect runtime evidence after a gameplay repro." />
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button x:Name="BtnWorkflowGoFindings"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,8,8"
                                        Content="Go Findings"
                                        Click="BtnWorkflowGoFindings_Click" />
                                <Button x:Name="BtnWorkflowGoLoadOrder"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="0,0,0,8"
                                        Content="Go Load Order"
                                        Click="BtnWorkflowGoLoadOrder_Click" />
                                <Button x:Name="BtnWorkflowGoIsolation"
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,0,8,0"
                                        Content="Go Isolation"
                                        Click="BtnWorkflowGoIsolation_Click" />
                                <Button x:Name="BtnWorkflowGoRuntime"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Content="Go Runtime"
                                        Click="BtnWorkflowGoRuntime_Click" />
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="GroupAdvancedPaths" Header="Advanced Paths (Optional)">
                        <Expander Header="Override Auto-Discovery Paths"
                                  IsExpanded="False"
                                  Foreground="#E7D8BE">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Foreground="#D8C7AA" Text="Module Roots (semicolon separated)" />
                                <TextBox x:Name="TxtModuleRoots" Margin="0,4,0,8" />
                                <TextBlock Foreground="#D8C7AA" Text="Workshop Root" />
                                <TextBox x:Name="TxtWorkshopRoot" Margin="0,4,0,8" />
                                <TextBlock Foreground="#D8C7AA" Text="LauncherData.xml" />
                                <TextBox x:Name="TxtLauncherData" Margin="0,4,0,8" />
                                <TextBlock Foreground="#D8C7AA" Text="Save Root" />
                                <TextBox x:Name="TxtSaveRoot" Margin="0,4,0,8" />
                                <TextBlock Foreground="#D8C7AA" Text="Harmony Logs Root (optional)" />
                                <TextBox x:Name="TxtHarmonyLogsRoot" Margin="0,4,0,8" />
                                <TextBlock Foreground="#C9B592"
                                           TextWrapping="Wrap"
                                           Text="Leave blank to auto-detect from Steam and Documents paths." />
                            </StackPanel>
                        </Expander>
                    </GroupBox>

                    <GroupBox x:Name="GroupOverview" Header="Overview">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Margin="0,0,6,8" Padding="10" CornerRadius="8" Background="#1C1F24" BorderBrush="#6D5330" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Modules" Foreground="#D9C6A5" />
                                    <TextBlock x:Name="TxtModulesCount" FontSize="22" FontWeight="Bold" Text="0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" Margin="6,0,0,8" Padding="10" CornerRadius="8" Background="#1C1F24" BorderBrush="#6D5330" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Findings" Foreground="#D9C6A5" />
                                    <TextBlock x:Name="TxtFindingsCount" FontSize="22" FontWeight="Bold" Text="0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Margin="0,0,6,8" Padding="10" CornerRadius="8" Background="#3C1B27" BorderBrush="#744357" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Critical" Foreground="#FFC7D2" />
                                    <TextBlock x:Name="TxtCriticalCount" FontSize="20" FontWeight="Bold" Text="0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Margin="6,0,0,8" Padding="10" CornerRadius="8" Background="#433316" BorderBrush="#7A6233" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="High" Foreground="#FFE6B7" />
                                    <TextBlock x:Name="TxtHighCount" FontSize="20" FontWeight="Bold" Text="0" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="BorderCriticalFocus"
                                    Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    Margin="0,0,0,8"
                                    Padding="10"
                                    CornerRadius="8"
                                    Background="#4A212D"
                                    BorderBrush="#8E4C5C"
                                    BorderThickness="1"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Critical Focus" Foreground="#FFD6DF" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TxtCriticalFocusSummary"
                                               Margin="0,4,0,8"
                                               Foreground="#FFEAF0"
                                               TextWrapping="Wrap"
                                               FontWeight="SemiBold"
                                               Text="No critical blockers detected." />
                                    <TextBlock x:Name="TxtCriticalFocusContext"
                                               Margin="0,0,0,8"
                                               Foreground="#FFDCE4"
                                               TextWrapping="Wrap"
                                               Text="Critical means high-impact risk; runtime evidence determines certainty." />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnJumpToCritical"
                                                Grid.Column="0"
                                                Style="{StaticResource ActionRowButtonStyle}"
                                                Content="Jump To Critical"
                                                Click="BtnJumpToCritical_Click" />
                                        <Button x:Name="BtnCriticalOnlyView"
                                                Grid.Column="1"
                                                Style="{StaticResource ActionRowButtonStyle}"
                                                Content="Critical Only"
                                                Click="BtnCriticalOnlyView_Click" />
                                        <Button x:Name="BtnResetFindingsView"
                                                Grid.Column="2"
                                                Margin="0"
                                                Style="{StaticResource ActionRowButtonStyle}"
                                                Content="Reset Findings View"
                                                Click="BtnResetFindingsView_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,8" Padding="10" CornerRadius="8" Background="#1F1D1B" BorderBrush="#7A6233" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Top Recommendation" Foreground="#F0DDB2" />
                                    <TextBlock x:Name="TxtTopRecommendation"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               FontWeight="SemiBold"
                                               Text="Run scan to generate recommendations." />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,8" Padding="10" CornerRadius="8" Background="#1C1D20" BorderBrush="#6D5330" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Runtime Evidence" Foreground="#E3D1B4" />
                                    <TextBlock x:Name="TxtRuntimeEvidenceSummary"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               FontWeight="SemiBold"
                                               Foreground="#F1E2C6"
                                               Text="No scan yet. Run Collect Runtime Evidence to verify Harmony conflicts from runtime logs." />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="5" Grid.ColumnSpan="2" Margin="0,0,0,8" Padding="10" CornerRadius="8" Background="#1B1C20" BorderBrush="#6D5330" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Analysis Confidence" Foreground="#E3D1B4" />
                                    <TextBlock x:Name="TxtConfidenceSummary"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               FontWeight="SemiBold"
                                               Foreground="#F1E2C6"
                                               Text="No scan yet." />
                                    <TextBlock x:Name="TxtConfidenceBreakdown"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="#CDBA97"
                                               Text="Run a scan to compute confidence from deterministic, heuristic, and runtime evidence." />
                                    <Border Margin="0,8,0,6" Height="1" Background="#6D5330" />
                                    <TextBlock Text="Session Risk Score" Foreground="#E3D1B4" />
                                    <TextBlock x:Name="TxtRiskScore"
                                               Margin="0,4,0,0"
                                               Foreground="#F1E2C6"
                                               FontWeight="SemiBold"
                                               Text="Risk Score: n/a" />
                                    <ProgressBar x:Name="RiskScoreBar"
                                                 Margin="0,6,0,0"
                                                 Height="12"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="0"
                                                 Foreground="#B88A3C"
                                                 Background="#0B0C0F"
                                                 BorderBrush="#5E4729"
                                                 BorderThickness="1" />
                                    <TextBlock x:Name="TxtRiskScoreHint"
                                               Margin="0,4,0,0"
                                               Foreground="#CDBA97"
                                               TextWrapping="Wrap"
                                               Text="Risk score updates after each scan." />
                                    <TextBlock x:Name="TxtRiskTopDrivers"
                                               Margin="0,6,0,0"
                                               Foreground="#E7D8BE"
                                               TextWrapping="Wrap"
                                               Text="Top drivers: n/a" />
                                    <Button x:Name="BtnFocusRiskDriver"
                                            Margin="0,8,0,0"
                                            Width="190"
                                            Content="Open Top Risk Driver"
                                            Click="BtnFocusRiskDriver_Click" />
                                </StackPanel>
                            </Border>
                            <TextBlock Grid.Row="6"
                                       Grid.ColumnSpan="2"
                                       Foreground="#C9B592"
                                       TextWrapping="Wrap"
                                       Text="This app prioritizes precision. Deterministic conflicts are strict; likely issues include confidence scores." />
                        </Grid>
                    </GroupBox>

                    <GroupBox x:Name="GroupNextSteps" Header="What To Do Next">
                        <ListBox x:Name="ListNextSteps"
                                 Height="180"
                                 Background="#0F1217"
                                 BorderBrush="#6D5330"
                                 Foreground="#EADCC3" />
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          Background="#3A2A1C"
                          ShowsPreview="True"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border x:Name="BorderOnboardingTip"
                        Grid.Row="0"
                        Margin="0,0,0,8"
                        Padding="10,8"
                        CornerRadius="8"
                        BorderBrush="#73552E"
                        BorderThickness="1"
                        Background="#1A1714">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid x:Name="GridOnboardingMessage"
                              Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtOnboardingTip"
                                       Foreground="#E8D9C0"
                                       TextWrapping="Wrap"
                                       Text="Tip: run a scan, then use Findings -> Load Order -> Validate." />
                            <Button x:Name="BtnDismissOnboardingTip"
                                    Grid.Column="1"
                                    Width="90"
                                    Margin="10,0,0,0"
                                    Content="Dismiss"
                                    Click="BtnDismissOnboardingTip_Click" />
                        </Grid>

                        <Grid x:Name="GridQuickWorkflowSteps"
                              Grid.Row="1"
                              Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="BorderQuickStepScan"
                                    Grid.Column="0"
                                    Margin="0,0,8,0"
                                    Padding="10,8"
                                    CornerRadius="8"
                                    Background="#231C17"
                                    BorderBrush="#7C6036"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="#F3E5C8"
                                               Text="1) Scan" />
                                    <TextBlock x:Name="TxtQuickStepScanState"
                                               Margin="0,4,0,0"
                                               Foreground="#D9C8AB"
                                               TextWrapping="Wrap"
                                               Text="Run scan to build a risk baseline." />
                                    <Button x:Name="BtnQuickStepScan"
                                            Margin="0,8,0,0"
                                            Style="{StaticResource ActionRowButtonStyle}"
                                            Content="Run Scan"
                                            Click="BtnRunScan_Click" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="BorderQuickStepFix"
                                    Grid.Column="1"
                                    Margin="0,0,8,0"
                                    Padding="10,8"
                                    CornerRadius="8"
                                    Background="#231C17"
                                    BorderBrush="#7C6036"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="#F3E5C8"
                                               Text="2) Triage and Fix" />
                                    <TextBlock x:Name="TxtQuickStepFixState"
                                               Margin="0,4,0,0"
                                               Foreground="#D9C8AB"
                                               TextWrapping="Wrap"
                                               Text="Open findings and apply suggested order for top blockers." />
                                    <Button x:Name="BtnQuickStepFix"
                                            Margin="0,8,0,0"
                                            Style="{StaticResource ActionRowButtonStyle}"
                                            Content="Apply Suggested Order"
                                            Click="BtnApplyLoadOrder_Click" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="BorderQuickStepValidate"
                                    Grid.Column="2"
                                    Padding="10,8"
                                    CornerRadius="8"
                                    Background="#231C17"
                                    BorderBrush="#7C6036"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="#F3E5C8"
                                               Text="3) Validate Runtime" />
                                    <TextBlock x:Name="TxtQuickStepValidateState"
                                               Margin="0,4,0,0"
                                               Foreground="#D9C8AB"
                                               TextWrapping="Wrap"
                                               Text="Collect runtime evidence after gameplay repro." />
                                    <Button x:Name="BtnQuickStepValidate"
                                            Margin="0,8,0,0"
                                            Style="{StaticResource ActionRowButtonStyle}"
                                            Content="Collect Runtime Evidence"
                                            Click="BtnCollectRuntimeEvidence_Click" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
                <TabControl x:Name="MainTabs"
                            Grid.Row="1"
                            BorderBrush="#6C522C"
                            Background="#0F0F11"
                            Foreground="#F1E2C6"
                            SelectionChanged="MainTabs_SelectionChanged">
                <TabItem x:Name="TabFindings">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                <Canvas Width="16" Height="16">
                                    <Rectangle Width="11" Height="2" RadiusX="1" RadiusY="1" Fill="#F3E5C8" Canvas.Left="1" Canvas.Top="3" />
                                    <Rectangle Width="11" Height="2" RadiusX="1" RadiusY="1" Fill="#F3E5C8" Canvas.Left="1" Canvas.Top="7" />
                                    <Rectangle Width="8" Height="2" RadiusX="1" RadiusY="1" Fill="#F3E5C8" Canvas.Left="1" Canvas.Top="11" />
                                    <Path Fill="#C89A56" Data="M13,1 L15,3 L13,5 L11,3 Z" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock VerticalAlignment="Center" Text="Findings" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="RowFindingsGrid" Height="2*" />
                            <RowDefinition Height="8" />
                            <RowDefinition x:Name="RowFindingsDetail" Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="ColFindingsDrawerSplitter" Width="0" />
                            <ColumnDefinition x:Name="ColFindingsDrawer" Width="0" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="BorderFindingsToolbar"
                                Grid.Row="0"
                                Grid.ColumnSpan="3"
                                Margin="0,0,0,8"
                                Padding="8"
                                CornerRadius="8"
                                Background="#171513"
                                BorderBrush="#70552E"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="TxtFindingsToolbarIntro"
                                           Foreground="#E2D1B6"
                                           Text="Plain-language triage table first. Open Refine Results only when you need filters or advanced triage controls."
                                           TextWrapping="Wrap" />
                                <Expander x:Name="ExpFindingsRefineResults"
                                          Margin="0,8,0,0"
                                          IsExpanded="False"
                                          Header="Refine Results"
                                          Foreground="#F1E2C6">
                                    <ScrollViewer x:Name="ScrollFindingsToolbar"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="True"
                                                  MaxHeight="240">
                                        <StackPanel Margin="0,8,0,0">
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="#F3E4C8"
                                               Text="Filters" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,8">
                                            <TextBlock Style="{StaticResource ActionRowLabelStyle}" Text="Perspective" />
                                            <ComboBox x:Name="ComboPerspectiveFilter"
                                                      Background="#161A21"
                                                      Foreground="#F3E4CB"
                                                      SelectionChanged="Filters_Changed" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                            <TextBlock Style="{StaticResource ActionRowLabelStyle}" Text="Severity" />
                                            <ComboBox x:Name="ComboSeverityFilter"
                                                      Background="#161A21"
                                                      Foreground="#F3E4CB"
                                                      SelectionChanged="Filters_Changed" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Style="{StaticResource ActionRowLabelStyle}" Text="Category" />
                                            <ComboBox x:Name="ComboCategoryFilter"
                                                      Background="#161A21"
                                                      Foreground="#F3E4CB"
                                                      SelectionChanged="Filters_Changed" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1">
                                            <TextBlock Style="{StaticResource ActionRowLabelStyle}" Text="Search" />
                                            <TextBox x:Name="TxtSearch"
                                                     Background="#13161B"
                                                     Foreground="#F3E4CB"
                                                     BorderBrush="#6F5630"
                                                     TextChanged="Filters_Changed" />
                                        </StackPanel>
                                        <TextBlock x:Name="TxtFindingsFiltered"
                                                   Grid.Row="2"
                                                   Grid.ColumnSpan="2"
                                                   Margin="0,8,0,0"
                                                   FontWeight="SemiBold"
                                                   Foreground="#D8C7AA"
                                                   Text="0 visible findings" />
                                    </Grid>

                                    <Border Margin="0,10,0,8" Height="1" Background="#6F5530" />

                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="#F3E4C8"
                                               Text="Triage Actions" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Style="{StaticResource ActionRowButtonStyle}"
                                                Content="Focus Critical"
                                                Click="BtnJumpToCritical_Click" />
                                        <Button Grid.Column="1"
                                                Style="{StaticResource ActionRowButtonStyle}"
                                                Content="Actionable View"
                                                Click="BtnActionableView_Click" />
                                        <Button Grid.Column="2"
                                                Margin="0"
                                                Style="{StaticResource ActionRowButtonStyle}"
                                                Content="Reset View"
                                                Click="BtnResetFindingsView_Click" />
                                    </Grid>
                                    <CheckBox x:Name="ChkCompactFindingsLayout"
                                              Margin="0,6,0,0"
                                              Content="Compact findings layout"
                                              Checked="ChkCompactFindingsLayout_Changed"
                                              Unchecked="ChkCompactFindingsLayout_Changed" />
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="#D3C1A2"
                                               Text="Actionable View keeps only critical/high findings so triage stays focused."
                                               TextWrapping="Wrap" />

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="115" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="0,4,8,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="#E7D7BD"
                                                   FontWeight="SemiBold"
                                                   Text="Confidence Floor" />
                                        <ComboBox x:Name="ComboConfidenceFloor"
                                                  Grid.Column="1"
                                                  Width="110"
                                                  Background="#161A21"
                                                  Foreground="#F3E4CB"
                                                  SelectionChanged="Filters_Changed" />
                                        <TextBlock Grid.Column="2"
                                                   Margin="10,4,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="#D3C1A2"
                                                   Text="High/Critical and runtime-backed findings stay visible regardless of this threshold."
                                                   TextWrapping="Wrap" />
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnQuickCriticalChip"
                                                Grid.Column="0"
                                                Style="{StaticResource ActionRowButtonStyle}"
                                                Content="Critical: 0"
                                                Click="BtnQuickCriticalChip_Click" />
                                        <Button x:Name="BtnQuickHighChip"
                                                Grid.Column="1"
                                                Style="{StaticResource ActionRowButtonStyle}"
                                                Content="High: 0"
                                                Click="BtnQuickHighChip_Click" />
                                        <Button x:Name="BtnQuickRuntimeChip"
                                                Grid.Column="2"
                                                Margin="0"
                                                Style="{StaticResource ActionRowButtonStyle}"
                                                Content="Runtime Confirmed: 0"
                                                Click="BtnQuickRuntimeChip_Click" />
                                    </Grid>

                                    <TextBlock x:Name="TxtFindingsPlayerStatus"
                                               Margin="0,8,0,0"
                                               Foreground="#F0DEBC"
                                               FontWeight="SemiBold"
                                               Text="Visible findings: no scan yet." />
                                    <TextBlock x:Name="TxtFindingsSeveritySnapshot"
                                               Margin="0,8,0,0"
                                               Foreground="#E2D1B6"
                                               FontWeight="SemiBold"
                                               Text="Visible mix: no findings yet." />
                                    <TextBlock x:Name="TxtActiveFindingsFilters"
                                               Margin="0,4,0,0"
                                               Foreground="#D3C1A2"
                                               TextWrapping="Wrap"
                                               Text="Active filters: defaults (gameplay stability, all severities, all categories)." />

                                    <Expander x:Name="ExpPriorityQueue"
                                              Margin="0,10,0,0"
                                              Header="Priority Queue (Top Risk Drivers)"
                                              IsExpanded="False"
                                              Foreground="#E7D8BE">
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock x:Name="TxtPriorityQueueSummary"
                                                       Foreground="#D3C1A2"
                                                       TextWrapping="Wrap"
                                                       Text="Run scan to generate priority queue." />
                                            <ListBox x:Name="ListPriorityQueue"
                                                     Margin="0,8,0,0"
                                                     MaxHeight="140"
                                                     MouseDoubleClick="ListPriorityQueue_MouseDoubleClick"
                                                     Background="#0F1217"
                                                     BorderBrush="#6D5330"
                                                     Foreground="#EADCC3" />
                                            <Button x:Name="BtnFocusPriorityQueueSelection"
                                                    Margin="0,8,0,0"
                                                    HorizontalAlignment="Left"
                                                    Content="Focus Selected Queue Item"
                                                    Click="BtnFocusPriorityQueueSelection_Click" />
                                        </StackPanel>
                                    </Expander>

                                    <Expander x:Name="ExpCriticalRuntimeDrawer"
                                              Margin="0,10,0,0"
                                              Header="Critical Runtime Drawer"
                                              IsExpanded="False"
                                              Foreground="#FFE2EA">
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock x:Name="TxtCriticalRuntimeDrawerSummary"
                                                       Foreground="#FFDDE5"
                                                       TextWrapping="Wrap"
                                                       Text="Run scan to populate runtime-priority blockers." />
                                            <ListBox x:Name="ListCriticalRuntimeDrawer"
                                                     Margin="0,8,0,0"
                                                     MaxHeight="150"
                                                     MouseDoubleClick="ListCriticalRuntimeDrawer_MouseDoubleClick"
                                                     Background="#1C1514"
                                                     BorderBrush="#8B5B50"
                                                     Foreground="#FFE8DD">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Display}"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="#FFE8DD" />
                                                            <TextBlock Margin="0,2,0,0"
                                                                       Text="{Binding Reason}"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="#E8C9BF"
                                                                       FontSize="12" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="BtnFocusCriticalRuntimeSelection"
                                                        Grid.Column="0"
                                                        Style="{StaticResource ActionRowButtonStyle}"
                                                        Content="Focus Selected Blocker"
                                                        Click="BtnFocusCriticalRuntimeSelection_Click" />
                                                <Button x:Name="BtnFilterCriticalRuntimeModule"
                                                        Grid.Column="1"
                                                        Margin="0"
                                                        Style="{StaticResource ActionRowButtonStyle}"
                                                        Content="Filter By Selected Module"
                                                        Click="BtnFilterCriticalRuntimeModule_Click" />
                                            </Grid>
                                        </StackPanel>
                                    </Expander>

                                    <TextBlock x:Name="TxtSelectedFindingSummary"
                                               Margin="0,10,0,0"
                                               Foreground="#D8C7AA"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Text="Selected finding: none. Click a row for full details." />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Expander>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1"
                                Grid.ColumnSpan="3"
                                Margin="0,0,0,8"
                                Padding="8,6"
                                CornerRadius="6"
                                Background="#1B1714"
                                BorderBrush="#7A5D34"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtFindingsHint"
                                           Foreground="#E2D1B6"
                                           Text="Player view: plain-language warnings first. Advanced cause and load-order context stay in the detail drawer."
                                           TextWrapping="Wrap" />
                                <Button x:Name="BtnToggleFindingsControls"
                                        Grid.Column="1"
                                        Width="190"
                                        Margin="12,0,0,0"
                                        Content="Hide Findings Controls"
                                        Click="BtnToggleFindingsControls_Click" />
                            </Grid>
                        </Border>

                        <DataGrid x:Name="GridFindings"
                                  Grid.Row="2"
                                  Grid.ColumnSpan="3"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  SelectionChanged="GridFindings_SelectionChanged"
                                  PreviewKeyDown="DataGrid_PreviewKeyDown"
                                  RowStyle="{StaticResource FindingRowStyle}"
                                  MinRowHeight="40"
                                  CanUserSortColumns="True"
                                  FrozenColumnCount="2"
                                  Background="#0F1217"
                                  BorderBrush="#6D5330"
                                  Foreground="#EADCC3"
                                  ScrollViewer.CanContentScroll="True"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="ColFindingRisk" Header="Risk" Binding="{Binding Severity}" Width="76" />
                                <DataGridTextColumn x:Name="ColFindingIssue" Header="What It Means" Binding="{Binding PlayerHeadline}" Width="260" />
                                <DataGridTextColumn x:Name="ColFindingConfidence" Header="How Sure" Binding="{Binding ConfidenceText}" Width="92" />
                                <DataGridTextColumn x:Name="ColFindingEvidence" Header="How I Know" Binding="{Binding EvidenceStrength}" Width="130" />
                                <DataGridTextColumn x:Name="ColFindingImpact" Header="Main Risk" Binding="{Binding ImpactRisk}" Width="160" />
                                <DataGridTextColumn x:Name="ColFindingModules" Header="Mods" Binding="{Binding Modules}" Width="220" />
                                <DataGridTemplateColumn x:Name="ColFindingSymptoms" Header="What You'd Notice" Width="2.2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PlayerSymptom}"
                                                       TextWrapping="Wrap"
                                                       ToolTip="{Binding PlayerSymptom}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn x:Name="ColFindingQuickFix" Header="First Thing To Try" Width="2.3*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding QuickFix}"
                                                       TextWrapping="Wrap"
                                                       ToolTip="{Binding QuickFix}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <GridSplitter x:Name="FindingsRowSplitter"
                                      Grid.Row="3"
                                      Grid.ColumnSpan="3"
                                      Height="8"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center"
                                      Background="#3A2A1C"
                                      ShowsPreview="True"
                                      ResizeBehavior="PreviousAndNext"
                                      ResizeDirection="Rows" />

                        <GridSplitter x:Name="FindingsColumnSplitter"
                                      Grid.Row="2"
                                      Grid.RowSpan="3"
                                      Grid.Column="1"
                                      Width="8"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Background="#3A2A1C"
                                      ShowsPreview="True"
                                      ResizeBehavior="PreviousAndNext"
                                      ResizeDirection="Columns"
                                      Visibility="Collapsed" />

                        <Border x:Name="BorderFindingsDetail"
                                Grid.Row="4"
                                Grid.ColumnSpan="3"
                                Margin="0,8,0,0"
                                Padding="10"
                                MinHeight="220"
                                CornerRadius="8"
                                Background="#171513"
                                BorderBrush="#70552E"
                                BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="True">
                            <Grid Margin="0,0,6,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border HorizontalAlignment="Left"
                                            Padding="10,4"
                                            CornerRadius="6"
                                            Background="#5B211C"
                                            BorderBrush="#8F6B38"
                                            BorderThickness="1">
                                        <TextBlock FontWeight="Bold"
                                                   FontSize="16"
                                                   FontFamily="Georgia"
                                                   Foreground="#F7EAD1"
                                                   Text="Selected Finding" />
                                    </Border>
                                    <Button x:Name="BtnClearFindingSelection"
                                            Grid.Column="1"
                                            Width="120"
                                            Margin="10,0,0,0"
                                            Content="Clear Selection"
                                            Click="BtnClearFindingSelection_Click" />
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" Padding="8,4" CornerRadius="6" BorderBrush="#70552E" BorderThickness="1" Background="#221B16">
                                        <TextBlock x:Name="TxtDetailCategoryBadge" Foreground="#F1E2C6" Text="Category: -" />
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="1" Margin="0,0,8,8" Padding="8,4" CornerRadius="6" BorderBrush="#6D5A37" BorderThickness="1" Background="#3B3020">
                                        <TextBlock x:Name="TxtDetailSeverityBadge" Foreground="#FFEAC0" Text="Severity: -" />
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="2" Margin="0,0,0,8" Padding="8,4" CornerRadius="6" BorderBrush="#7B6135" BorderThickness="1" Background="#2A2119">
                                        <TextBlock x:Name="TxtDetailConfidenceBadge" Foreground="#E8D7BA" Text="Confidence: -" />
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="0" Margin="0,0,8,0" Padding="8,4" CornerRadius="6" BorderBrush="#57714F" BorderThickness="1" Background="#1C241F">
                                        <TextBlock x:Name="TxtDetailEvidenceBadge" Foreground="#D7E8D0" Text="Evidence: -" />
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="1" Margin="0,0,8,0" Padding="8,4" CornerRadius="6" BorderBrush="#6B4F2E" BorderThickness="1" Background="#3A2C1B">
                                        <TextBlock x:Name="TxtDetailImpactBadge" Foreground="#FFE7C7" Text="Impact: -" />
                                    </Border>
                                </Grid>

                                <Border Grid.Row="2" Margin="0,8,0,0" Padding="10,8" CornerRadius="8" Background="#211A16" BorderBrush="#70552E" BorderThickness="1">
                                    <StackPanel>
                                        <Border x:Name="BorderDetailPriority"
                                                Margin="0,0,0,6"
                                                Padding="8,4"
                                                CornerRadius="6"
                                                Background="#2A231D"
                                                BorderBrush="#6F5530"
                                                BorderThickness="1">
                                            <TextBlock x:Name="TxtDetailPriority"
                                                       Foreground="#FFF0D0"
                                                       FontWeight="SemiBold"
                                                       Text="Priority: Select a finding" />
                                        </Border>
                                        <TextBlock x:Name="TxtDetailConfidenceInterpretation"
                                                   Margin="0,0,0,6"
                                                   Foreground="#D3C1A2"
                                                   Text="Confidence interpretation appears after selecting a finding."
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="TxtDetailPlayerSummary"
                                                   Foreground="#F2E4C8"
                                                   Text="Select a finding to view details."
                                                   TextWrapping="Wrap"
                                                   FontWeight="SemiBold" />
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="BtnDetailOpenLoadOrder"
                                                    Grid.Column="0"
                                                    Style="{StaticResource ActionRowButtonStyle}"
                                                    Content="Open Load Order"
                                                    Click="BtnWorkflowGoLoadOrder_Click" />
                                            <Button x:Name="BtnDetailOpenRuntime"
                                                    Grid.Column="1"
                                                    Style="{StaticResource ActionRowButtonStyle}"
                                                    Content="Open Runtime"
                                                    Click="BtnWorkflowGoRuntime_Click" />
                                            <Button x:Name="BtnDetailOpenIsolation"
                                                    Grid.Column="2"
                                                    Margin="0"
                                                    Style="{StaticResource ActionRowButtonStyle}"
                                                    Content="Open Isolation"
                                                    Click="BtnWorkflowGoIsolation_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Expander x:Name="ExpanderCriticalExplain"
                                          Grid.Row="3"
                                          Margin="0,10,0,0"
                                          Padding="2"
                                          IsExpanded="True"
                                          Visibility="Collapsed"
                                          Header="Why this is marked critical">
                                    <StackPanel Margin="8,6,8,2">
                                        <TextBlock x:Name="TxtCriticalExplainSummary"
                                                   Foreground="#E2D1B6"
                                                   TextWrapping="Wrap"
                                                   Text="Select a high-risk finding to see explainability evidence." />
                                        <ListBox x:Name="ListCriticalExplain"
                                                 Margin="0,8,0,0"
                                                 Background="#0F1217"
                                                 BorderBrush="#6D5330"
                                                 Foreground="#EADCC3" />
                                    </StackPanel>
                                </Expander>

                                <TextBlock Grid.Row="4" Margin="0,8,0,0" Foreground="#F1E2C6" TextWrapping="Wrap">
                                    <Run Text="What this means in play: " FontWeight="Bold" />
                                    <Run x:Name="TxtDetailOutcome" Text="-" />
                                </TextBlock>
                                <TextBlock Grid.Row="5" Margin="0,8,0,0" Foreground="#F1E2C6" TextWrapping="Wrap">
                                    <Run Text="What to try first: " FontWeight="Bold" />
                                    <Run x:Name="TxtDetailRecommendation" Text="-" />
                                </TextBlock>
                                <TextBlock x:Name="BlockDetailTechnicalRow" Grid.Row="6" Margin="0,8,0,0" Foreground="#D3C1A2" TextWrapping="Wrap">
                                    <Run Text="Why the app thinks this (advanced): " FontWeight="Bold" />
                                    <Run x:Name="TxtDetailTechnical" Text="-" />
                                </TextBlock>
                                <TextBlock x:Name="BlockDetailExecutionRow" Grid.Row="7" Margin="0,8,0,0" Foreground="#D3C1A2" TextWrapping="Wrap">
                                    <Run Text="Advanced context: " FontWeight="Bold" />
                                    <Run x:Name="TxtDetailExecutionChain" Text="-" />
                                </TextBlock>
                                <GroupBox x:Name="GroupDetailAffectedSaves"
                                          Grid.Row="8"
                                          Margin="0,10,0,0"
                                          Header="Affected Saves"
                                          Visibility="Collapsed">
                                    <ListBox x:Name="ListAffectedSaves"
                                             MinHeight="96"
                                             Background="#0F1217"
                                             BorderBrush="#6D5330"
                                             Foreground="#EADCC3" />
                                </GroupBox>
                                <Grid Grid.Row="9" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="ColDetailChecklist" Width="1.2*" />
                                        <ColumnDefinition x:Name="ColDetailEvidence" Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <GroupBox Grid.Column="0" Header="Fix Checklist" Margin="0,0,8,0">
                                        <ListBox x:Name="ListImmediateSteps"
                                                 Background="#0F1217"
                                                 BorderBrush="#6D5330"
                                                 Foreground="#EADCC3" />
                                    </GroupBox>
                                    <GroupBox x:Name="GroupDetailEvidence" Grid.Column="1" Header="Raw Evidence (Advanced)">
                                        <ListBox x:Name="ListEvidence"
                                                 Background="#0F1217"
                                                 BorderBrush="#6D5330"
                                                 Foreground="#EADCC3" />
                                    </GroupBox>
                                </Grid>
                            </Grid>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="TabLoadOrder">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                <Canvas Width="16" Height="16">
                                    <Rectangle Width="10" Height="2" RadiusX="1" RadiusY="1" Fill="#F3E5C8" Canvas.Left="3" Canvas.Top="2" />
                                    <Rectangle Width="10" Height="2" RadiusX="1" RadiusY="1" Fill="#F3E5C8" Canvas.Left="3" Canvas.Top="7" />
                                    <Rectangle Width="10" Height="2" RadiusX="1" RadiusY="1" Fill="#F3E5C8" Canvas.Left="3" Canvas.Top="12" />
                                    <Path Fill="#C89A56" Data="M2,1 L5,4 L2,7 Z" />
                                    <Path Fill="#C89A56" Data="M14,9 L11,12 L14,15 Z" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock VerticalAlignment="Center" Text="Load Order" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Style="{StaticResource TabActionBarStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ActionRowHintStyle}"
                                           Text="Apply suggested order, then verify with a short launch + battle sanity pass." />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.7*" />
                                        <ColumnDefinition Width="1.2*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Style="{StaticResource ActionRowButtonStyle}"
                                            Content="Run Scan"
                                            Click="BtnRunScan_Click" />
                                    <Button Grid.Column="1"
                                            Style="{StaticResource ActionRowButtonStyle}"
                                            Content="Apply Suggested Order"
                                            Click="BtnApplyLoadOrder_Click" />
                                    <Button Grid.Column="2"
                                            Margin="0"
                                            Style="{StaticResource ActionRowButtonStyle}"
                                            Content="Go Findings"
                                            Click="BtnWorkflowGoFindings_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid x:Name="GridLoadOrderWorkbench" Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ColLoadOrderPlan" Width="380" MinWidth="300" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <GroupBox Grid.Column="0" Header="Do These Moves">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="TxtLoadOrderPlanHint"
                                               Margin="0,0,0,8"
                                               Foreground="#D8C7AA"
                                               TextWrapping="Wrap"
                                               Text="Do These Moves only covers enabled modules that actually need action. Exact Slots on the right is the authoritative enabled-order view." />
                                    <ListBox Grid.Row="1"
                                             x:Name="ListLoadOrderMoves"
                                             Background="#0F1217"
                                             BorderBrush="#6D5330"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             Foreground="#EADCC3" />
                                    <Border x:Name="BorderLoadOrderInactiveModules"
                                            Grid.Row="2"
                                            Margin="0,10,0,0"
                                            Padding="10,8"
                                            CornerRadius="8"
                                            Background="#171513"
                                            BorderBrush="#70552E"
                                            BorderThickness="1"
                                            Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtLoadOrderInactiveSummary"
                                                       Foreground="#F1E2C6"
                                                       FontWeight="SemiBold"
                                                       Text="Installed But Not Enabled" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Foreground="#D3C1A2"
                                                       Text="These modules are installed but currently off, so they are not part of this order recommendation."
                                                       TextWrapping="Wrap" />
                                            <ListBox x:Name="ListLoadOrderInactiveModules"
                                                     Margin="0,8,0,0"
                                                     MaxHeight="120"
                                                     Background="#0F1217"
                                                     BorderBrush="#6D5330"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     Foreground="#EADCC3" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </GroupBox>

                            <GridSplitter Grid.Column="1"
                                          Width="10"
                                          HorizontalAlignment="Stretch"
                                          Background="#3A2A1C"
                                          ShowsPreview="True"
                                          ResizeBehavior="PreviousAndNext"
                                          ResizeDirection="Columns" />

                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border x:Name="BorderLoadOrderFocusSummary"
                                        Grid.Row="0"
                                        Margin="0,0,0,8"
                                        Padding="10,8"
                                        CornerRadius="8"
                                        Background="#16181C"
                                        BorderBrush="#6F5530"
                                        BorderThickness="1">
                                    <TextBlock x:Name="TxtLoadOrderFocusSummary"
                                               Foreground="#E2D1B6"
                                               TextWrapping="Wrap"
                                               Text="No order changes inferred for enabled modules yet. Exact Slots is the source of truth; Do These Moves is the actionable subset." />
                                </Border>

                                 <Grid x:Name="GridLoadOrderFocusedHost"
                                       Grid.Row="1"
                                       Visibility="Collapsed">
                                    <GroupBox Header="Exact Slots">
                                        <DataGrid x:Name="GridLoadOrderTable"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  SelectionMode="Extended"
                                                  SelectionUnit="FullRow"
                                                  SelectionChanged="GridLoadOrder_SelectionChanged"
                                                  PreviewKeyDown="DataGrid_PreviewKeyDown"
                                                  RowStyle="{StaticResource LoadOrderRowStyle}"
                                                  MinRowHeight="42"
                                                  FrozenColumnCount="2"
                                                  Background="#0F1217"
                                                  BorderBrush="#6D5330"
                                                  Foreground="#EADCC3"
                                                  ScrollViewer.CanContentScroll="True"
                                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                  GridLinesVisibility="Horizontal"
                                                  HeadersVisibility="Column">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="Type" Width="110">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="2"
                                                                    Padding="6,3"
                                                                    CornerRadius="6"
                                                                    Background="{Binding ModuleTypeBadgeBackground}"
                                                                    BorderBrush="{Binding ModuleTypeBadgeBorder}"
                                                                    BorderThickness="1">
                                                                <TextBlock HorizontalAlignment="Center"
                                                                           Foreground="{Binding ModuleTypeForeground}"
                                                                           FontWeight="SemiBold"
                                                                           Text="{Binding ModuleTypeText}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="Module" Binding="{Binding ModuleId}" Width="*" />
                                                <DataGridTextColumn Header="Current #" Binding="{Binding CurrentIndexText}" Width="95" />
                                                <DataGridTextColumn Header="Suggested #" Binding="{Binding SuggestedIndexText}" Width="95" />
                                                <DataGridTextColumn Header="Change" Binding="{Binding DeltaText}" Width="95" />
                                                <DataGridTextColumn Header="Action" Binding="{Binding ActionText}" Width="170" />
                                                <DataGridTextColumn Header="Why It Matters" Binding="{Binding WhyText}" Width="1.5*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </GroupBox>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="TabValidate">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                <Canvas Width="16" Height="16">
                                    <Path Stroke="#F3E5C8" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M1,9 L4,9 L6,4 L9,12 L12,7 L15,7" />
                                    <Ellipse Width="3" Height="3" Fill="#C89A56" Canvas.Left="1" Canvas.Top="7.5" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="TxtRuntimeTabHeader"
                                       VerticalAlignment="Center"
                                       Text="Validate" />
                        </StackPanel>
                    </TabItem.Header>
                        <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="RowValidateIsolationEscalation" Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="RowRuntimeWorkbench" Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Style="{StaticResource TabActionBarStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Style="{StaticResource SectionBannerBorderStyle}">
                                    <TextBlock x:Name="TxtRuntimeActionBanner"
                                               Style="{StaticResource SectionBannerTextStyle}"
                                               Text="Runtime Validation Center" />
                                </Border>
                                <TextBlock x:Name="TxtRuntimeForensicsSummary"
                                           Grid.Row="1"
                                           Margin="0,6,0,0"
                                           Style="{StaticResource TabSectionHintStyle}"
                                           Text="No game-run help is loaded yet." />
                                <Border x:Name="BorderValidateCurrentCard"
                                        Grid.Row="2"
                                        Margin="0,10,0,0"
                                        Padding="10"
                                        CornerRadius="8"
                                        Background="#1B1714"
                                        BorderBrush="#7A5D34"
                                        BorderThickness="1"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border HorizontalAlignment="Left"
                                                    Padding="10,4"
                                                    CornerRadius="6"
                                                    Background="#5B211C"
                                                    BorderBrush="#8F6B38"
                                                    BorderThickness="1">
                                                <TextBlock x:Name="TxtValidateCurrentCardTitle"
                                                           FontWeight="Bold"
                                                           FontSize="16"
                                                           FontFamily="Georgia"
                                                           Foreground="#F7EAD1"
                                                            Text="What To Test Now" />
                                            </Border>
                                            <Button x:Name="BtnValidateResetCurrent"
                                                    Grid.Column="1"
                                                    Margin="10,0,0,0"
                                                    Style="{StaticResource ActionRowButtonStyle}"
                                                    Content="Reset"
                                                    Click="BtnResetIsolation_Click"
                                                    Visibility="Collapsed" />
                                        </Grid>
                                        <TextBlock x:Name="TxtValidateStageSummary"
                                                   Margin="0,8,0,0"
                                                   Foreground="#E7D8BE"
                                                   FontWeight="SemiBold"
                                                   Text="Pick a finding to validate. Keep the stack together first. Only isolate if the issue reproduces."
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="TxtValidateProfileHint"
                                                   Margin="0,6,0,0"
                                                   Foreground="#D8C7AA"
                                                   Text="Run a scan first, then validate the current stack."
                                                   TextWrapping="Wrap"
                                                   Visibility="Collapsed" />

                                        <StackPanel x:Name="PanelValidateChooseTarget"
                                                    Margin="0,10,0,0">
                                            <WrapPanel>
                                                <Button x:Name="BtnValidateUseSelectedFinding"
                                                        Margin="0,0,10,10"
                                                        Style="{StaticResource ActionRowButtonStyle}"
                                                        Content="Use Selected Warning"
                                                        Click="BtnStartIsolationFromSelectedFinding_Click" />
                                            </WrapPanel>
                                            <Border x:Name="BorderValidateChooseTargetRuntimeAssist"
                                                    Margin="0,2,0,0"
                                                    Padding="12,10"
                                                    CornerRadius="8"
                                                    Background="#171513"
                                                    BorderBrush="#70552E"
                                                    BorderThickness="1"
                                                    Visibility="Collapsed">
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock VerticalAlignment="Center"
                                                               Foreground="#D8C7AA"
                                                               Text="Need help from logs?"
                                                               TextWrapping="Wrap" />
                                                    <Button x:Name="BtnValidateChooseTargetShowEvidence"
                                                            Margin="12,0,0,0"
                                                            Style="{StaticResource ActionRowButtonStyle}"
                                                            Content="Show Game Runs"
                                                            Click="BtnValidateShowEvidence_Click" />
                                                </DockPanel>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel x:Name="PanelValidateTestTogether"
                                                    Margin="0,10,0,0"
                                                    Visibility="Collapsed">
                                            <TextBlock x:Name="TxtValidateFocusLine"
                                                       Foreground="#F1E2C6"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding ElementName=TxtIsolationFocusSummary, Path=Text}"
                                                       TextWrapping="Wrap" />
                                            <Border Margin="0,10,0,0"
                                                    Padding="12"
                                                    CornerRadius="8"
                                                    Background="#171513"
                                                    BorderBrush="#70552E"
                                                    BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Foreground="#F0DDB2"
                                                               FontWeight="SemiBold"
                                                               Text="Stack To Keep Together" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Foreground="#F3E5C8"
                                                               Text="{Binding ElementName=TxtIsolationCurrentDisableSet, Path=Text}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,12,0,0"
                                                               Foreground="#D9E4D0"
                                                               FontWeight="SemiBold"
                                                               Text="Always On" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Foreground="#E2F0DD"
                                                               Text="{Binding ElementName=TxtIsolationCurrentFoundationSet, Path=Text}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,12,0,0"
                                                               Foreground="#D7E2F0"
                                                               FontWeight="SemiBold"
                                                               Text="What To Try In Game" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Foreground="#E6EEF9"
                                                               Text="{Binding ElementName=TxtIsolationCurrentKeepSet, Path=Text}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock x:Name="TxtValidateNextStepLine"
                                                       Margin="0,10,0,0"
                                                       Foreground="#E8D9C0"
                                                       Text="{Binding ElementName=TxtIsolationNextAction, Path=Text}"
                                                       TextWrapping="Wrap" />
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="BtnValidateCompatible"
                                                        Grid.Column="0"
                                                        Style="{StaticResource ActionRowButtonStyle}"
                                                        Content="Looks Fine In Game"
                                                        IsEnabled="{Binding ElementName=BtnIsolationIssueGone, Path=IsEnabled}"
                                                        Click="BtnIsolationIssueGone_Click" />
                                                <Button x:Name="BtnValidateIssueReproduced"
                                                        Grid.Column="1"
                                                        Margin="0"
                                                        Style="{StaticResource ActionRowButtonStyle}"
                                                        Content="Issue Shows Up"
                                                        IsEnabled="{Binding ElementName=BtnIsolationIssuePersists, Path=IsEnabled}"
                                                        Click="BtnIsolationIssuePersists_Click" />
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel x:Name="PanelValidateCompatible"
                                                    Margin="0,10,0,0"
                                                    Visibility="Collapsed">
                                            <TextBlock x:Name="TxtValidateCompatibleSummary"
                                                       Foreground="#F1E2C6"
                                                       FontWeight="SemiBold"
                                                       Text="This stack looked fine in game for the test you ran."
                                                       TextWrapping="Wrap" />
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Margin="0,0,8,0"
                                                        Padding="10,8"
                                                        CornerRadius="8"
                                                        Background="#2A2018"
                                                        BorderBrush="#7A6135"
                                                        BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Foreground="#F0DDB2"
                                                                   FontWeight="SemiBold"
                                                                    Text="Mods You Tested" />
                                                        <TextBlock x:Name="TxtValidateCompatibleModules"
                                                                   Margin="0,4,0,0"
                                                                   Foreground="#F3E5C8"
                                                                   Text="-"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="1"
                                                        Padding="10,8"
                                                        CornerRadius="8"
                                                        Background="#1D2026"
                                                        BorderBrush="#5D6882"
                                                        BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Foreground="#D7E2F0"
                                                                   FontWeight="SemiBold"
                                                                    Text="What You Tested" />
                                                        <TextBlock x:Name="TxtValidateCompatibleGoal"
                                                                   Margin="0,4,0,0"
                                                                   Foreground="#E6EEF9"
                                                                   Text="-"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <WrapPanel Margin="0,10,0,0">
                                                <Button x:Name="BtnValidateAnotherFinding"
                                                        Margin="0,0,10,10"
                                                        Style="{StaticResource ActionRowButtonStyle}"
                                                        Content="Try Another Warning"
                                                        Click="BtnValidateAnotherFinding_Click" />
                                                <Button x:Name="BtnValidateShowEvidence"
                                                        Margin="0,0,0,10"
                                                        Style="{StaticResource ActionRowButtonStyle}"
                                                        Content="Show Game Runs"
                                                        Click="BtnValidateShowEvidence_Click"
                                                        Visibility="Collapsed" />
                                            </WrapPanel>
                                        </StackPanel>

                                        <StackPanel x:Name="PanelValidateIsolating"
                                                    Margin="0,10,0,0"
                                                    Visibility="Collapsed">
                                            <TextBlock x:Name="TxtValidateIsolatingSummary"
                                               Foreground="#F1E2C6"
                                               FontWeight="SemiBold"
                                               Text="{Binding ElementName=TxtIsolationFocusSummary, Path=Text}"
                                               TextWrapping="Wrap" />
                                            <TextBlock Margin="0,8,0,0"
                                                       Foreground="#D8C7AA"
                                                       Text="{Binding ElementName=TxtIsolationNextAction, Path=Text}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Border x:Name="BorderValidateRuntimeHeader"
                                Grid.Row="2"
                                Margin="0,0,0,8"
                                Padding="10,8"
                                CornerRadius="8"
                                Background="#171513"
                                BorderBrush="#70552E"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                     <TextBlock x:Name="TxtValidateRuntimeSectionTitle"
                                                Foreground="#F1E2C6"
                                                FontWeight="SemiBold"
                                                Text="Game Runs" />
                                     <TextBlock x:Name="TxtValidateRuntimeSectionHint"
                                                Margin="0,4,0,0"
                                                Foreground="#D8C7AA"
                                                Text="Leave this closed unless something actually goes wrong in game."
                                                TextWrapping="Wrap" />
                                 </StackPanel>
                                 <Button x:Name="BtnToggleValidateRuntimeEvidence"
                                         Grid.Column="1"
                                         MinWidth="180"
                                         Margin="12,0,0,0"
                                         Style="{StaticResource ActionRowButtonStyle}"
                                         Content="Show Game Runs"
                                         Click="BtnToggleValidateRuntimeEvidence_Click" />
                             </Grid>
                         </Border>

                        <Border x:Name="BorderValidateRuntimeEmptyState"
                                Grid.Row="3"
                                Margin="0,0,0,8"
                                Padding="12"
                                CornerRadius="8"
                                Background="#171513"
                                BorderBrush="#70552E"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <StackPanel>
                                 <TextBlock Foreground="#F1E2C6"
                                            FontWeight="SemiBold"
                                           Text="No game runs are loaded yet. Play once, then open this section only if you need help from logs."
                                           TextWrapping="Wrap" />
                                 <Button x:Name="BtnValidateRuntimeEmptyWatch"
                                         Width="220"
                                         Margin="0,10,0,0"
                                         HorizontalAlignment="Left"
                                         Style="{StaticResource ActionRowButtonStyle}"
                                         Content="Start Live Session Watch"
                                         Click="BtnToggleLiveRuntimeWatch_Click" />
                              </StackPanel>
                          </Border>

                        <Border x:Name="BorderPlayerRuntimeWorkbench"
                                Grid.Row="3"
                                Margin="0,0,0,8"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="390" MinWidth="340" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <GroupBox Grid.Column="0" Header="Recent Game Runs">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="TxtPlayerRuntimeRunsHint"
                                                   Margin="0,0,0,10"
                                                   Style="{StaticResource TabSectionHintStyle}"
                                                   Text="Pick the run that best matches what just happened in game." />
                                        <WrapPanel Grid.Row="1"
                                                   Margin="0,0,0,10">
                                            <Button x:Name="BtnPlayerRuntimeClearFilterLocal"
                                                    Margin="0,0,10,0"
                                                    Style="{StaticResource ActionRowButtonStyle}"
                                                    Content="Clear Run Filter"
                                                    Click="BtnClearRuntimeForensicsFilter_Click" />
                                            <Button x:Name="BtnPlayerRuntimeWatchLocal"
                                                    Style="{StaticResource ActionRowButtonStyle}"
                                                    Content="Start Live Session Watch"
                                                    Click="BtnToggleLiveRuntimeWatch_Click" />
                                        </WrapPanel>
                                        <ListBox x:Name="ListPlayerRuntimeRuns"
                                                 Grid.Row="2"
                                                 Background="#0F1217"
                                                 BorderBrush="#6D5330"
                                                 Foreground="#EADCC3"
                                                 SelectionMode="Single"
                                                 SelectionChanged="ListPlayerRuntimeRuns_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource PlayerRuntimeCardBorderStyle}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontWeight="Bold"
                                                                       FontSize="15"
                                                                       Foreground="#F4E7D0" />
                                                            <TextBlock Margin="0,4,0,0"
                                                                       Text="{Binding Subtitle}"
                                                                       Foreground="#E2D1B6"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Margin="0,6,0,0"
                                                                       Text="{Binding Summary}"
                                                                       Foreground="#D5C3A4"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </GroupBox>

                                <GridSplitter Grid.Column="1"
                                              Width="12"
                                              HorizontalAlignment="Stretch"
                                              Background="#3A2A1C"
                                              ShowsPreview="True"
                                              ResizeBehavior="PreviousAndNext"
                                              ResizeDirection="Columns" />

                                <GroupBox Grid.Column="2" Header="What the Logs Suggest">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0"
                                                   LastChildFill="False">
                                            <TextBlock x:Name="TxtPlayerRuntimeSummaryHint"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource TabSectionHintStyle}"
                                                       Text="These are the clearest log-based warnings for the runs you can see right now." />
                                            <Button x:Name="BtnPlayerRuntimeUseTopWarning"
                                                    Margin="12,0,0,0"
                                                    Style="{StaticResource ActionRowButtonStyle}"
                                                    Content="Use Top Log Warning"
                                                    Click="BtnStartIsolationFromTopRuntime_Click"
                                                    Visibility="Collapsed" />
                                        </DockPanel>
                                        <ListBox x:Name="GridPlayerRuntimeSuggestions"
                                                 Grid.Row="2"
                                                 Margin="0,10,0,0"
                                                 Background="#0F1217"
                                                 BorderBrush="#6D5330"
                                                 Foreground="#EADCC3"
                                                 SelectionMode="Single"
                                                 SelectionChanged="GridPlayerRuntimeSuggestions_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource PlayerRuntimeCardBorderStyle}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Headline}"
                                                                       FontWeight="Bold"
                                                                       FontSize="15"
                                                                       Foreground="#F4E7D0"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Margin="0,6,0,0"
                                                                       Text="{Binding Explanation}"
                                                                       Foreground="#D8C7AA"
                                                                       TextWrapping="Wrap" />
                                                            <Grid Margin="0,10,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0"
                                                                        Margin="0,0,8,0"
                                                                        Padding="10,8"
                                                                        CornerRadius="8"
                                                                        Background="#211913"
                                                                        BorderBrush="#6E5631"
                                                                        BorderThickness="1">
                                                                    <StackPanel>
                                                                        <TextBlock Foreground="#F0DDB2"
                                                                                   FontWeight="SemiBold"
                                                                                   Text="Mods involved" />
                                                                        <TextBlock Margin="0,4,0,0"
                                                                                   Foreground="#F3E5C8"
                                                                                   Text="{Binding Modules}"
                                                                                   TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border Grid.Column="1"
                                                                        Padding="10,8"
                                                                        CornerRadius="8"
                                                                        Background="#1A1E24"
                                                                        BorderBrush="#5D6882"
                                                                        BorderThickness="1">
                                                                    <StackPanel>
                                                                        <TextBlock Foreground="#D7E2F0"
                                                                                   FontWeight="SemiBold"
                                                                                   Text="When / log file" />
                                                                        <TextBlock Margin="0,4,0,0"
                                                                                   Foreground="#E6EEF9"
                                                                                   Text="{Binding WhenAndLog}"
                                                                                   TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </Grid>
                                                            <TextBlock Margin="0,10,0,0"
                                                                       Foreground="#E7D7BD"
                                                                       FontWeight="SemiBold"
                                                                       Text="{Binding NextStep}"
                                                                       TextWrapping="Wrap" />
                                                            <WrapPanel Margin="0,10,0,0">
                                                                <Button Margin="0,0,10,0"
                                                                        Style="{StaticResource ActionRowButtonStyle}"
                                                                        Content="Open Log"
                                                                        IsEnabled="{Binding HasLogPath}"
                                                                        Tag="{Binding}"
                                                                        Click="BtnPlayerRuntimeCardOpenLog_Click" />
                                                                <Button Style="{StaticResource ActionRowButtonStyle}"
                                                                        Content="Go To Warning"
                                                                        Tag="{Binding}"
                                                                        Click="BtnPlayerRuntimeCardFocusFinding_Click" />
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Expander x:Name="ExpanderPlayerRuntimeMoreDetails"
                                                   Grid.Row="3"
                                                   Margin="0,10,0,0"
                                                  Header="More Details (Optional)"
                                                  IsExpanded="False">
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <GroupBox Grid.Column="0" Header="Raw Log Files">
                                                    <DataGrid x:Name="GridPlayerRuntimeLogDetails"
                                                              AutoGenerateColumns="False"
                                                              IsReadOnly="True"
                                                              SelectionMode="Single"
                                                              SelectionUnit="FullRow"
                                                              SelectionChanged="GridPlayerRuntimeLogDetails_SelectionChanged"
                                                              MouseDoubleClick="GridRuntimeFocusedLogs_MouseDoubleClick"
                                                              PreviewKeyDown="DataGrid_PreviewKeyDown"
                                                              Background="#0F1217"
                                                              BorderBrush="#6D5330"
                                                              Foreground="#EADCC3"
                                                              ScrollViewer.CanContentScroll="True"
                                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                              RowBackground="#111419"
                                                              AlternatingRowBackground="#181C22"
                                                              GridLinesVisibility="Horizontal"
                                                              HeadersVisibility="Column">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Type" Binding="{Binding SignalType}" Width="120" />
                                                            <DataGridTextColumn Header="When / log file" Binding="{Binding FileName}" Width="*" />
                                                            <DataGridTextColumn Header="Warnings" Binding="{Binding FindingHits}" Width="90" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </GroupBox>
                                                <GridSplitter Grid.Column="1"
                                                              Width="10"
                                                              HorizontalAlignment="Stretch"
                                                              Background="#3A2A1C"
                                                              ShowsPreview="True"
                                                              ResizeBehavior="PreviousAndNext"
                                                              ResizeDirection="Columns" />
                                                <GroupBox Grid.Column="2" Header="Mods Seen Often">
                                                    <DataGrid x:Name="GridPlayerRuntimeModuleDetails"
                                                              AutoGenerateColumns="False"
                                                              IsReadOnly="True"
                                                              SelectionMode="Single"
                                                              SelectionUnit="FullRow"
                                                              SelectionChanged="GridPlayerRuntimeModuleDetails_SelectionChanged"
                                                              PreviewKeyDown="DataGrid_PreviewKeyDown"
                                                              Background="#0F1217"
                                                              BorderBrush="#6D5330"
                                                              Foreground="#EADCC3"
                                                              ScrollViewer.CanContentScroll="True"
                                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                              RowBackground="#111419"
                                                              AlternatingRowBackground="#181C22"
                                                              GridLinesVisibility="Horizontal"
                                                              HeadersVisibility="Column">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Module" Binding="{Binding ModuleId}" Width="*" />
                                                            <DataGridTextColumn Header="Warnings" Binding="{Binding CorrelatedFindings}" Width="90" />
                                                            <DataGridTextColumn Header="Runs" Binding="{Binding SessionCoverage}" Width="80" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </GroupBox>
                                            </Grid>
                                        </Expander>
                                    </Grid>
                                </GroupBox>
                            </Grid>
                        </Border>

                        <GroupBox x:Name="GroupValidateIsolationEscalation"
                                  Grid.Row="1"
                                  Margin="0,8,0,0"
                                  Header="If The Problem Shows Up"
                                  Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <GroupBox Grid.Column="0" Header="Mods To Split Next">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="TxtIsolationCandidatesCount"
                                                   Margin="0,0,0,8"
                                                   Foreground="#D8C7AA"
                                                   Text="0 suspect modules"
                                                   TextWrapping="Wrap" />
                                        <ListBox x:Name="ListIsolationCandidates"
                                                 Grid.Row="1"
                                                 Background="#0F1217"
                                                 BorderBrush="#6D5330"
                                                 Foreground="#EADCC3" />
                                    </Grid>
                                </GroupBox>

                                <GridSplitter Grid.Column="1"
                                              Width="10"
                                              HorizontalAlignment="Stretch"
                                              Background="#3A2A1C"
                                              ShowsPreview="True"
                                              ResizeBehavior="PreviousAndNext"
                                              ResizeDirection="Columns" />

                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Margin="0,0,0,8"
                                            Padding="10"
                                            CornerRadius="8"
                                            Background="#16181C"
                                            BorderBrush="#6F5530"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtIsolationFocusSummary"
                                                       Foreground="#E2D1B6"
                                                       Text="Validation and isolation keep official foundations active while you test only player-controlled suspect mods."
                                                       TextWrapping="Wrap" />
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.05*" />
                                                    <ColumnDefinition Width="0.95*" />
                                                    <ColumnDefinition Width="1.05*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Margin="0,0,8,0"
                                                        Padding="10,8"
                                                        CornerRadius="8"
                                                        Background="#2A2018"
                                                        BorderBrush="#7A6135"
                                                        BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock x:Name="TxtIsolationDisableHeader"
                                                                   Foreground="#F0DDB2"
                                                                   FontWeight="SemiBold"
                                                                   Text="Turn Off This Cohort" />
                                                        <TextBlock x:Name="TxtIsolationCurrentDisableSet"
                                                                   Margin="0,4,0,0"
                                                                   Foreground="#F3E5C8"
                                                                   Text="-"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="1"
                                                        Margin="0,0,8,0"
                                                        Padding="10,8"
                                                        CornerRadius="8"
                                                        Background="#1D241C"
                                                        BorderBrush="#5E7658"
                                                        BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock x:Name="TxtIsolationFoundationHeader"
                                                                   Foreground="#D9E4D0"
                                                                   FontWeight="SemiBold"
                                                                   Text="Keep Foundations Active" />
                                                        <TextBlock x:Name="TxtIsolationCurrentFoundationSet"
                                                                   Margin="0,4,0,0"
                                                                   Foreground="#E2F0DD"
                                                                   Text="No locked foundations."
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="2"
                                                        Padding="10,8"
                                                        CornerRadius="8"
                                                        Background="#1D2026"
                                                        BorderBrush="#5D6882"
                                                        BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock x:Name="TxtIsolationKeepHeader"
                                                                   Foreground="#D7E2F0"
                                                                   FontWeight="SemiBold"
                                                                   Text="Other Suspects Stay On" />
                                                        <TextBlock x:Name="TxtIsolationCurrentKeepSet"
                                                                   Margin="0,4,0,0"
                                                                   Foreground="#E6EEF9"
                                                                   Text="-"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <TextBlock x:Name="TxtIsolationNextAction"
                                                       Margin="0,10,0,0"
                                                       Foreground="#E8D9C0"
                                                       Text="No active isolation step. Build a plan from findings first."
                                                       TextWrapping="Wrap" />
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="BtnIsolationIssueGone"
                                                        Grid.Column="0"
                                                        Style="{StaticResource ActionRowButtonStyle}"
                                                        Content="Issue Gone"
                                                        Click="BtnIsolationIssueGone_Click" />
                                                <Button x:Name="BtnIsolationIssuePersists"
                                                        Grid.Column="1"
                                                        Margin="0"
                                                        Style="{StaticResource ActionRowButtonStyle}"
                                                        Content="Issue Persists"
                                                        Click="BtnIsolationIssuePersists_Click" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <DataGrid x:Name="GridIsolationSteps"
                                              Grid.Row="1"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              SelectionMode="Extended"
                                              SelectionUnit="FullRow"
                                              PreviewKeyDown="DataGrid_PreviewKeyDown"
                                              MinRowHeight="42"
                                              Background="#0F1217"
                                              BorderBrush="#6D5330"
                                              Foreground="#EADCC3"
                                              ScrollViewer.CanContentScroll="True"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              RowBackground="#111419"
                                              AlternatingRowBackground="#181C22"
                                              GridLinesVisibility="Horizontal"
                                              HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="#" Binding="{Binding Step}" Width="48" />
                                            <DataGridTextColumn Header="Turn Off" Binding="{Binding DisableSet}" Width="1.6*" />
                                            <DataGridTextColumn Header="Foundations Kept" Binding="{Binding FoundationSet}" Width="1.2*" />
                                            <DataGridTextColumn Header="Other Suspects On" Binding="{Binding KeepSet}" Width="1.4*" />
                                            <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="130" />
                                            <DataGridTextColumn Header="Remaining" Binding="{Binding RemainingAfter}" Width="90" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Grid>
                        </GroupBox>
                        </Grid>
                </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Padding="10,6"
                CornerRadius="8"
                BorderBrush="#70552E"
                BorderThickness="1"
                Background="#121315">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatusFooter"
                           Grid.Row="0"
                           Grid.Column="0"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Foreground="#E2D1B3"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Text="Ready. Run a scan to begin." />
                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           MaxWidth="340"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Foreground="#CBB693"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Text="Designed for readable decision support, not raw logs." />
                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar x:Name="ScanProgressBar"
                                 Grid.Column="0"
                                 Height="16"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Foreground="#B88A3C"
                                 Background="#0B0C0F"
                                 BorderBrush="#5E4729"
                                 BorderThickness="1" />
                    <TextBlock x:Name="TxtProgressFooter"
                               Grid.Column="1"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#E2D1B3"
                               FontWeight="SemiBold"
                               Text="0%" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

